{
    "name": "nuxt-app",
    "version": "1.1.0",
    "packageManager": "pnpm@12.9.1",
    "type": "module",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=9.0.0"
    },
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev -p 3020",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{vue,ts,js,css,json,md}\"",
        "format:check": "prettier --check \"**/*.{vue,ts,js,css,json,md}\"",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@dargmuesli/nuxt-cookie-control": "^9.3.8",
        "@nuxt/devtools": "^2.7.0",
        "@nuxt/eslint": "^1.17.0",
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/image": "^2.1.0",
        "@nuxt/test-utils": "^4.3.3",
        "@nuxtjs/sitemap": "^8.6.1",
        "@nuxtjs/tailwindcss": "^6.14.0",
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.12.0",
        "happy-dom": "^20.14.5",
        "nuxt": "4.4.8",
        "nuxt-gtag": "^5.0.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^3.4.19",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9",
        "vue-tsc": "^3.3.12"
    },
    "dependencies": {
        "isomorphic-dompurify": "^4.4.0",
        "vue-recaptcha-v3": "^2.0.1"
    }
}
