{
  "name": "nuxt-app",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev -p 3020",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{vue,ts,js,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{vue,ts,js,css,json,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@dargmuesli/nuxt-cookie-control": "^9.2.0",
    "@nuxt/devtools": "^2.7.0",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/sitemap": "^8.2.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^22.20.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "happy-dom": "^20.10.6",
    "nuxt": "^4.4.8",
    "nuxt-gtag": "^4.1.0",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  },
  "dependencies": {
    "isomorphic-dompurify": "^3.18.0",
    "vue-recaptcha-v3": "^2.0.1"
  }
}
